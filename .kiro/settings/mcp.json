{
  "mcpServers": {
    "mcp-gcp-mock": {
      "command": "npx",
      "args": ["tsx", "packages/mcp-gcp-mock/src/index.ts"],
      "env": {
        "MCP_PROJECT_ROOT": "${workspaceFolder}"
      },
      "disabled": false
    },
    "mcp-ui": {
      "command": "npx",
      "args": ["tsx", "packages/mcp-ui/src/index.ts"],
      "env": {
        "MCP_PROJECT_ROOT": "${workspaceFolder}"
      },
      "disabled": false
    },
    "mcp-main": {
      "command": "node",
      "args": ["packages/mcp-main/dist/index.js"],
      "env": {
        "DASHBOARD_URL": "http://localhost:3000",
        "MCP_PROJECT_ROOT": "${workspaceFolder}"
      },
      "disabled": false
    }
  }
}


{
  "info": {
    "name": "MCP MVP Dashboard — API",
    "description": "Collection para testear el pipeline de generación de dashboards.\nBase URL: http://localhost:4000\nAntes de usar: npm run dev:mcp-main",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🟢 Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verifica que el servidor esté corriendo y el estado de las conexiones MCP."
          }
        }
      ]
    },

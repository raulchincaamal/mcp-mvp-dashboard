{
  "mcpServers": {
    "mcp-gcp-mock": {
      "command": "npx",
      "args": ["tsx", "packages/mcp-gcp-mock/src/index.ts"],
      "env": {
        "MCP_PROJECT_ROOT": "${workspaceFolder}"
      },
      "disabled": false
    },
    "mcp-ui": {
      "command": "npx",
      "args": ["tsx", "packages/mcp-ui/src/index.ts"],
      "env": {
        "MCP_PROJECT_ROOT": "${workspaceFolder}"
      },
      "disabled": false
    }
  }
}
